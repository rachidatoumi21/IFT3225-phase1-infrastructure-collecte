# --- Serveur ---
PORT=3000
MONGODB_URI=mongodb+srv://username:password@cluster-url/ift3225_ambiance?retryWrites=true&w=majority

# --- Bridge de collecte Phyphox (scripts/bridge.js) ---
# Adresse de l'accès distant Phyphox (affichée dans l'app)
PHYPHOX_URL=http://192.168.1.42:8080
# Nom du buffer Phyphox contenant la valeur en dB (vérifier via /config)
PHYPHOX_BUFFER=dB
# URL de l'API vers laquelle envoyer les mesures
API_URL=http://localhost:3000
# Clé API d'un device enregistré (affichée par npm run seed)
API_KEY=remplacer_par_une_cle_valide
# Lieu de collecte
LOCATION=bibliotheque-udem
# Intervalle de collecte en millisecondes
INTERVAL_MS=5000
